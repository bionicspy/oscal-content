      "remarks": "SDLC Supply Chain defines the capability to identify, assess, and manage risks introduced by third-party and open-source software components, build tools, base images, and external services. This pattern establishes provenance and dependency awareness but does not itself enforce change integrity or perform security testing."
    },

    "components": [
      {
        "uuid": "urn:utoronto:security:capability:dependency-identification-and-inventory",
        "type": "capability",
        "title": "Dependency Identification and Inventory",
        "description": "Identification and inventory of third-party, open-source, and external components used in software delivery.",
        "control-implementations": [
          {
            "uuid": "urn:utoronto:security:ci:sdlc-dependency-inventory",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/refs/heads/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "implemented-requirements": [
              {
                "uuid": "urn:utoronto:security:ir:sdlc-dependency-inventory-sr-3",
                "control-id": "sr-3",
                "remarks": "Identify and maintain an inventory of external software components and services."
              }
            ]
          }
        ]
      },
      {
        "uuid": "urn:utoronto:security:capability:supply-chain-risk-evaluation",
        "type": "capability",
        "title": "Supply Chain Risk Evaluation",
        "description": "Assessment of security and trust risks associated with third-party and open-source components.",
        "control-implementations": [
          {
            "uuid": "urn:utoronto:security:ci:sdlc-supply-chain-risk",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/refs/heads/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "implemented-requirements": [
              {
                "uuid": "urn:utoronto:security:ir:sdlc-supply-chain-risk-ra-3",
                "control-id": "ra-3",
                "remarks": "Assess risks posed by third-party and open-source software components."
              }
            ]
          }
        ]
      },
      {
        "uuid": "urn:utoronto:security:capability:provenance-and-origin-tracking",
        "type": "capability",
        "title": "Provenance and Origin Tracking",
        "description": "Tracking the origin, source, and lineage of software components and build artifacts.",
        "control-implementations": [
          {
            "uuid": "urn:utoronto:security:ci:sdlc-provenance-tracking",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/refs/heads/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "implemented-requirements": [
              {
                "uuid": "urn:utoronto:security:ir:sdlc-provenance-sr-4",
                "control-id": "sr-4",
                "remarks": "Maintain provenance information for software components and artifacts."
              }
            ]
          }
        ]
      }
    ]
  }
