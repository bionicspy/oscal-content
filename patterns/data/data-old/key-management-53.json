        "type": "capability",
        "title": "Key Generation",
        "description": "Secure generation of cryptographic keys using approved mechanisms.",
        "control-implementations": [
          {
            "uuid": "urn:utoronto:security:ci:key-generation",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/refs/heads/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "implemented-requirements": [
              {
                "uuid": "urn:utoronto:security:ir:key-generation-ia-7",
                "control-id": "ia-7",
                "remarks": "Approved cryptographic mechanisms are used for key generation."
              }
            ]
          }
        ]
      },
      {
        "uuid": "urn:utoronto:security:capability:key-storage-and-protection",
        "type": "capability",
        "title": "Key Storage and Protection",
        "description": "Secure storage of cryptographic keys with strong access controls.",
        "control-implementations": [
          {
            "uuid": "urn:utoronto:security:ci:key-storage",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/refs/heads/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "implemented-requirements": [
              {
                "uuid": "urn:utoronto:security:ir:key-storage-sc-12",
                "control-id": "sc-12",
                "remarks": "Cryptographic keys are protected from unauthorized disclosure or modification."
