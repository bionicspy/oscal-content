            ]
          }
        ]
      },
      {
        "uuid": "urn:utoronto:security:capability:key-rotation-and-renewal",
        "type": "capability",
        "title": "Key Rotation and Renewal",
        "description": "Periodic and event-driven rotation of cryptographic keys.",
        "control-implementations": [
          {
            "uuid": "urn:utoronto:security:ci:key-rotation",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/refs/heads/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "implemented-requirements": [
              {
                "uuid": "urn:utoronto:security:ir:key-rotation-ia-4",
                "control-id": "ia-4",
                "remarks": "Cryptographic keys are rotated and renewed in accordance with policy."
