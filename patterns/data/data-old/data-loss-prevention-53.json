{
  "component-definition": {
    "uuid": "urn:utoronto:security:pattern:data-loss-prevention",
    "metadata": {
      "title": "Data Loss Prevention",
      "version": "1.0.0",
      "oscal-version": "1.1.3",
      "last-modified": "2026-04-28T22:00:00Z",

      "props": [
        {
          "name": "capability",
          "ns": "urn:utoronto:cae2:brm",
          "class": "business-capability",
          "value": "urn:utoronto:cae2:brm:BC300"
        },
        {
          "name": "technology-domain",
          "ns": "urn:utoronto:cae2:trm",
          "class": "trm-domain",
          "value": "urn:utoronto:cae2:trm:TD030"
        },
        {
          "name": "architecture-pattern",
          "ns": "urn:utoronto:cae2:arm",
          "class": "solution-pattern",
          "value": "urn:utoronto:cae2:arm:AP126"
        },
        {
          "name": "data-entity",
          "ns": "urn:utoronto:cae2:drm",
          "class": "data-entity",
          "value": "urn:utoronto:cae2:drm:DE506"
        }
      ],

      "remarks": "Data Loss Prevention defines the capability to detect, restrict, and prevent unauthorized disclosure or exfiltration of institutional data. This pattern enforces controls on data movement and use based on classification and handling rules. It does not define data classification, encryption requirements, or key management, which are handled by other data trust patterns."
    },

    "components": [
      {
        "uuid": "urn:utoronto:security:capability:egress-monitoring-and-control",
        "type": "capability",
        "title": "Egress Monitoring and Control",
        "description": "Monitoring and control of outbound data flows to detect policy violations.",
        "control-implementations": [
          {
            "uuid": "urn:utoronto:security:ci:dlp-egress",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/refs/heads/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "implemented-requirements": [
              {
                "uuid": "urn:utoronto:security:ir:dlp-egress-ac-4",
                "control-id": "ac-4",
                "remarks": "Monitor and control the flow of sensitive data leaving institutional boundaries."
              }
            ]
          }
        ]
      },
      {
        "uuid": "urn:utoronto:security:capability:content-inspection-and-classification",
        "type": "capability",
        "title": "Content Inspection and Classification",
        "description": "Inspection of data content to identify sensitive information based on classification.",
        "control-implementations": [
          {
            "uuid": "urn:utoronto:security:ci:dlp-content-inspection",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/refs/heads/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "implemented-requirements": [
              {
                "uuid": "urn:utoronto:security:ir:dlp-content-si-4",
                "control-id": "si-4",
                "remarks": "Analyze data content to detect sensitive or prohibited information transfers."
              }
            ]
          }
        ]
      },
      {
        "uuid": "urn:utoronto:security:capability:policy-enforced-restrictions",
        "type": "capability",
        "title": "Policy-Enforced Restrictions",
        "description": "Enforcement actions such as blocking, warning, or conditional handling based on data policy.",
        "control-implementations": [
          {
            "uuid": "urn:utoronto:security:ci:dlp-policy-enforcement",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/refs/heads/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "implemented-requirements": [
              {
                "uuid": "urn:utoronto:security:ir:dlp-policy-ac-3",
                "control-id": "ac-3",
                "remarks": "Enforce policy decisions to restrict unauthorized data disclosure."
              }
            ]
          }
        ]
      },
      {
        "uuid": "urn:utoronto:security:capability:incident-signaling-and-escalation",
        "type": "capability",
        "title": "Incident Signaling and Escalation",
        "description": "Alerting and escalation when potential data loss incidents are detected.",
        "control-implementations": [
          {
            "uuid": "urn:utoronto:security:ci:dlp-incident-escalation",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/refs/heads/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "implemented-requirements": [
              {
                "uuid": "urn:utoronto:security:ir:dlp-incident-ir-4",
                "control-id": "ir-4",
                "remarks": "Initiate response actions when data loss events are detected."
              }
            ]
          }
        ]
      }
    ]
  }
}