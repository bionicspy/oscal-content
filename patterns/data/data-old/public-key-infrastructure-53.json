      "remarks": "Public Key Infrastructure defines the governance and operation of certificate authorities, trust anchors, certificate issuance, validation, and revocation. It enables cryptographic trust relationships between entities but does not manage encryption policy or key lifecycle."
    },

    "components": [
      {
        "uuid": "urn:utoronto:security:capability:certificate-authorities-and-trust-anchors",
        "type": "capability",
        "title": "Certificate Authorities and Trust Anchors",
        "description": "Definition and governance of root and intermediate certificate authorities used to establish trust.",
        "control-implementations": [
          {
            "uuid": "urn:utoronto:security:ci:pki-trust-anchors",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/refs/heads/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "implemented-requirements": [
              {
                "uuid": "urn:utoronto:security:ir:pki-trust-anchors-ia-7",
                "control-id": "ia-7",
                "remarks": "Establish and protect trusted certificate authorities and trust anchors."
              }
            ]
          }
        ]
      },
      {
        "uuid": "urn:utoronto:security:capability:certificate-issuance",
        "type": "capability",
        "title": "Certificate Issuance",
        "description": "Controlled enrollment and issuance of digital certificates to authorized entities.",
        "control-implementations": [
          {
            "uuid": "urn:utoronto:security:ci:pki-issuance",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/refs/heads/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "implemented-requirements": [
              {
                "uuid": "urn:utoronto:security:ir:pki-issuance-ia-5",
                "control-id": "ia-5",
                "remarks": "Issue and manage digital certificates for authenticated entities."
              }
            ]
          }
        ]
      },
      {
        "uuid": "urn:utoronto:security:capability:certificate-validation",
        "type": "capability",
        "title": "Certificate Validation",
        "description": "Verification of certificate trust chains prior to granting cryptographic trust.",
        "control-implementations": [
          {
            "uuid": "urn:utoronto:security:ci:pki-validation",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/refs/heads/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "implemented-requirements": [
              {
                "uuid": "urn:utoronto:security:ir:pki-validation-ia-7",
                "control-id": "ia-7",
                "remarks": "Validate certificate trust chains before acceptance."
              }
            ]
          }
        ]
      },
      {
        "uuid": "urn:utoronto:security:capability:certificate-revocation",
        "type": "capability",
        "title": "Certificate Revocation",
        "description": "Revocation of certificates that are expired, compromised, or no longer authorized.",
        "control-implementations": [
          {
            "uuid": "urn:utoronto:security:ci:pki-revocation",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/refs/heads/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "implemented-requirements": [
              {
                "uuid": "urn:utoronto:security:ir:pki-revocation-ia-5",
                "control-id": "ia-5",
                "remarks": "Revoke digital certificates when trust can no longer be maintained."
              }
            ]
          }
        ]
      },
      {
        "uuid": "urn:utoronto:security:capability:cross-domain-and-federated-trust",
        "type": "capability",
        "title": "Cross-Domain and Federated Trust",
        "description": "Establishment of trust relationships with external or federated certificate authorities.",
        "control-implementations": [
          {
            "uuid": "urn:utoronto:security:ci:pki-federation",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/refs/heads/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "implemented-requirements": [
              {
                "uuid": "urn:utoronto:security:ir:pki-federation-ia-7",
                "control-id": "ia-7",
                "remarks": "Manage trust relationships with external or federated certificate domains."
              }
            ]
          }
        ]
      }
    ]
  }
