{
  "component-definition": {
    "uuid": "urn:utoronto:security:pattern:logging-and-telemetry",

    "metadata": {
      "title": "Logging and Telemetry",
      "version": "1.0.0",
      "oscal-version": "1.1.3",
      "last-modified": "2026-04-29T00:45:00Z",

      "props": [
        {
          "name": "capability",
          "ns": "urn:utoronto:cae2:brm",
          "class": "business-capability",
          "value": "urn:utoronto:cae2:brm:BC330"
        },
        {
          "name": "technology-domain",
          "ns": "urn:utoronto:cae2:trm",
          "class": "trm-domain",
          "value": "urn:utoronto:cae2:trm:TD050"
        },
        {
          "name": "architecture-pattern",
          "ns": "urn:utoronto:cae2:arm",
          "class": "solution-pattern",
          "value": "urn:utoronto:cae2:arm:AP150"
        },
        {
          "name": "data-entity",
          "ns": "urn:utoronto:cae2:drm",
          "class": "data-entity",
          "value": "urn:utoronto:cae2:drm:DE540"
        }
      ],

      "remarks": "Logging and Telemetry defines the capability to generate, collect, securely transport, and preserve security-relevant telemetry from institutional systems, networks, applications, and delivery pipelines. This pattern ensures observability and evidentiary integrity but does not perform detection, correlation, or response actions."
    },

    "components": [
      {
        "uuid": "urn:utoronto:security:capability:telemetry-sources-and-coverage",
        "type": "capability",
        "title": "Telemetry Sources and Coverage",
        "description": "Definition of systems, services, and pipelines required to emit security-relevant telemetry.",
        "control-implementations": [
          {
            "uuid": "urn:utoronto:security:ci:telemetry-coverage",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/refs/heads/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "implemented-requirements": [
              {
                "uuid": "urn:utoronto:security:ir:telemetry-coverage-au-12",
                "control-id": "au-12",
                "remarks": "Ensure systems and applications generate audit records sufficient to support security monitoring."
              }
            ]
          }
        ]
      },
      {
        "uuid": "urn:utoronto:security:capability:log-collection-and-transport",
        "type": "capability",
        "title": "Log Collection and Transport",
        "description": "Secure collection, aggregation, and transport of logs and telemetry to centralized platforms.",
        "control-implementations": [
          {
            "uuid": "urn:utoronto:security:ci:log-collection",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/refs/heads/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "implemented-requirements": [
              {
                "uuid": "urn:utoronto:security:ir:log-collection-au-4",
                "control-id": "au-4",
                "remarks": "Aggregate and centralize security-relevant audit records."
              }
            ]
          }
        ]
      },
      {
        "uuid": "urn:utoronto:security:capability:log-integrity-and-retention",
        "type": "capability",
        "title": "Log Integrity and Retention",
        "description": "Protection of logs from unauthorized modification and enforcement of retention requirements.",
        "control-implementations": [
          {
            "uuid": "urn:utoronto:security:ci:log-integrity-retention",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/refs/heads/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "implemented-requirements": [
              {
                "uuid": "urn:utoronto:security:ir:log-integrity-au-9",
                "control-id": "au-9",
                "remarks": "Protect audit records from unauthorized modification and deletion."
              },
              {
                "uuid": "urn:utoronto:security:ir:log-retention-au-11",
                "control-id": "au-11",
                "remarks": "Retain audit records for defined periods to support investigation and compliance."
              }
            ]
          }
        ]
      }
    ]
  }
}